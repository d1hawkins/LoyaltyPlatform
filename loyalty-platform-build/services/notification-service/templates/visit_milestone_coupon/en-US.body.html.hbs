<div style="font-family: -apple-system, sans-serif; max-width: 400px; margin: 0 auto; padding: 20px;">
  <div style="text-align: center; padding: 20px; background: linear-gradient(135deg, #EB1256, #8E0E3C); border-radius: 12px; color: white; margin-bottom: 16px;">
    <div style="font-size: 32px; margin-bottom: 8px;">🎉</div>
    <h1 style="font-size: 20px; font-weight: 700; margin: 0 0 4px;">You've earned a reward!</h1>
    <p style="font-size: 14px; opacity: 0.9; margin: 0;">{{offerName}}</p>
  </div>
  <div style="text-align: center; padding: 20px; background: #f8f8f8; border-radius: 12px; margin-bottom: 16px;">
    <p style="font-size: 14px; color: #666; margin: 0 0 8px;">Your coupon code:</p>
    <div style="font-size: 24px; font-weight: 800; letter-spacing: 2px; color: #EB1256; background: white; padding: 12px 20px; border-radius: 8px; border: 2px dashed #EB1256; display: inline-block;">{{couponCode}}</div>
    <p style="font-size: 18px; font-weight: 700; color: #333; margin: 12px 0 0;">{{value}} off your next purchase</p>
  </div>
  <p style="font-size: 13px; color: #999; text-align: center;">Show this code at checkout on your next visit to Daiso.</p>
</div>