    "serviceBus": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "serviceBus-deploy",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[variables('serviceBusName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "952225353018004273"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Service Bus namespace name"
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "topics": {
              "type": "array",
              "defaultValue": [
                "member.enrolled",
                "points.earned",
                "points.redeemed",
                "tier.upgraded",
                "tier.downgraded",
                "transaction.voided",
                "member.deleted",
                "member.updated",
                "webhook.delivery"
              ]
            }
          },
          "resources": [
            {
              "type": "Microsoft.ServiceBus/namespaces",
