{
  "name": "@loyalty/loyalty-js-sdk",
  "version": "0.1.0",
  "description": "Client-side JavaScript SDK for the Loyalty Platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "lint": "eslint src --ext .ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "esbuild": "0.21.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  },
  "keywords": [
    "loyalty",
    "points",
    "rewards",
    "sdk",
    "shopify",
    "woocommerce"
  ],
  "license": "UNLICENSED"
}
