{
  "name": "loyalty-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./services/**\" run build",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./services/**\" run test",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"services/**/src/**/*.ts\"",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./services/**\" run typecheck",
    "dev": "pnpm -r --parallel --filter \"./services/**\" run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}
